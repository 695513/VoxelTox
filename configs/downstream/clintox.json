        "weight_decay": 0.001
      },
      "attention": {
        "lr": 0.0001,
        "weight_decay": 0.001
      },
      "projection": {
        "lr": 0.0001,
        "weight_decay": 0.001
      },
      "fusion_conv": {
        "lr": 8e-05,
        "weight_decay": 0.001
      },
      "scale_attn": {
        "lr": 0.0001,
        "weight_decay": 0.001
      },
      "multi_scale_fusion": {
        "lr": 0.0001,
        "weight_decay": 0.001
      },
      "residual_proj": {
        "lr": 0.0001,
